{
  "name": "@ebox/shopify-app",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "shopify": "shopify",
    "shopify:dev": "node scripts/set-backend.mjs dev && shopify app dev --config eboxsecure-dev",
    "shopify:deploy:dev": "node scripts/set-backend.mjs dev && shopify app deploy --config eboxsecure-dev",
    "shopify:deploy:prod": "node scripts/set-backend.mjs prod && shopify app deploy"
  },
  "dependencies": {
    "@ebox/db": "workspace:*",
    "@ebox/redis-client": "workspace:*",
    "@t3-oss/env-nextjs": "^0.9.2",
    "jose": "^5.8.0",
    "next": "^14.1.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^4.5.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@ebox/eslint-config": "workspace:*",
    "@ebox/prettier-config": "workspace:*",
    "@ebox/tsconfig": "workspace:*",
    "@types/node": "^20.12.5",
    "@types/react": "~19.0.10",
    "@types/react-dom": "^18.2.24",
    "dotenv-cli": "^7.4.1",
    "eslint": "^9.25.0",
    "jiti": "^1.21.0",
    "prettier": "^3.2.5",
    "typescript": "~5.8.3"
  },
  "prettier": "@ebox/prettier-config"
}
