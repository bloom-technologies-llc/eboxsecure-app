{
  // Informs the IDE and `tsc --noEmit`; the Shopify CLI bundles the extension itself.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["./src", "./shopify.d.ts"]
}
